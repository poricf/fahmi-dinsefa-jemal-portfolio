# Copy to .env and fill in values from Firebase Console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Gemini API key for the AI chat feature. Read only by the server-side
# Cloudflare Pages Function at functions/api/chat.ts — never bundled into
# client JS. Set here for local `wrangler pages dev`, and in the Cloudflare
# Pages dashboard (Settings → Environment variables) for production.
GEMINI_API_KEY=
